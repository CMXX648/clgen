# Anthropic API Key (required for default model)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (only if using --model openai/gpt-4o)
# OPENAI_API_KEY=sk-...

# DeepSeek API Key (only if using --model deepseek/deepseek-chat)
# DEEPSEEK_API_KEY=...


# For Windows users: If you have set environment variables via the System Properties, you can leave this file empty. The CLI will automatically read from the system environment variables.
# This file can be placed in two locations:
#   1. ~/.clgen/.env    — Global config (works from any directory)
#   2. ./.env           — Project-local config (overrides global)
